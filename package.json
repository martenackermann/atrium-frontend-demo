{
  "name": "atrium-frontend-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atrium - employee self-service portal demo (Nuxt 4 SPA).",
  "license": "MIT",
  "author": "Marten Ackermann",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "dev:demo": "nuxt dev --port 3000 --dotenv .env.demo",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "build:demo": "nuxt generate --dotenv .env.demo",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "screenshots": "playwright test --project=screenshots",
    "api:types": "node scripts/generate-api-types.mjs",
    "mocks:users": "node scripts/mock-users.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/hedvig-letters-serif": "^5.3.1",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.55.0",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "msw": "^2.15.0",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@tanstack/vue-query-devtools": "^6.3.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

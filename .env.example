# Copy to .env for local development. Local-dev placeholders only, never secrets.

# Base URL of the Atrium API (atrium-backend-demo). Default: the "main" row in WORKSPACE.md.
NUXT_PUBLIC_API_BASE=http://localhost:3100/api/v1

# true = run fully in the browser against MSW mocks + the in-browser mock database.
NUXT_PUBLIC_DEMO_MODE=false

# Source for `pnpm api:types` (file path or URL). Default: ../atrium-backend-demo/openapi.json
# ATRIUM_OPENAPI=http://localhost:3100/api/v1/openapi.json

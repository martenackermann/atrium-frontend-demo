# Loaded by `pnpm dev:demo` and `pnpm build:demo` (nuxt --dotenv .env.demo).
# Demo mode "msw": the API is served by MSW inside the browser; no backend needed.
NUXT_PUBLIC_DEMO_MODE=msw
NUXT_PUBLIC_API_BASE=/api/v1
# No mailbox in the offline demo (emails are skipped); the ribbon hides the link.
NUXT_PUBLIC_MAILPIT_URL=
